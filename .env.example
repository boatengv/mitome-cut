# Copy to .env for local development: cp .env.example .env
# Every value has a working local default except the two marked REQUIRED.

NODE_ENV=development
LOG_LEVEL=info

# REQUIRED. Matches docker-compose.yml's Postgres.
DATABASE_URL=postgres://mitome:mitome@localhost:5432/mitome

# REQUIRED. Long random string; signs local storage URLs. `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string-please

# Clerk (https://dashboard.clerk.com → API Keys). The VITE_ copy is the same publishable key, for the browser.
# Restrict who can sign up (allowlist, invite-only) in the Clerk dashboard.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ---------- Storage ----------
# local = files under ./data/storage, served by the API (no extra services).
# s3    = MinIO locally, Cloudflare R2 in production.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage

# MinIO from docker-compose.yml (set STORAGE_DRIVER=s3 to use it):
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=mitome
# S3_ACCESS_KEY_ID=mitome
# S3_SECRET_ACCESS_KEY=mitome-secret
# S3_FORCE_PATH_STYLE=true

# Cloudflare R2 (production):
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=mitome-media
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...

# ---------- Guardrails (keep usage and cost bounded) ----------
MAX_UPLOAD_MB=500
STORAGE_QUOTA_MB=5000
GENERATIONS_PER_DAY=20
EXPORTS_PER_DAY=30
MAX_PROJECTS_PER_USER=50

# ---------- Worker ----------
WORKER_CONCURRENCY=1
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# Nightly database backup to storage, e.g. "0 3 * * *". Empty = off.
BACKUP_CRON=
BACKUP_RETENTION_DAYS=14
