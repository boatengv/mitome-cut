# Copy to .env.production at the repo root ON THE SERVER (never commit it).
# Values marked <from terraform> come from `terraform output`.

DOMAIN=studio.example.com
ACME_EMAIL=you@example.com

# `openssl rand -base64 32`
POSTGRES_PASSWORD=
# `openssl rand -base64 48`
SESSION_SECRET=

NODE_ENV=production
LOG_LEVEL=info
# Turn on to create your account, then turn off and redeploy.
ALLOW_SIGNUP=false

# Cloudflare R2
STORAGE_DRIVER=s3
S3_ENDPOINT=<from terraform: r2_s3_endpoint>
S3_REGION=auto
S3_BUCKET=<from terraform: r2_bucket>
# Create an R2 API token (Object Read & Write, this bucket only) in the
# Cloudflare dashboard: R2 → Manage API tokens.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Guardrails
MAX_UPLOAD_MB=500
STORAGE_QUOTA_MB=5000
GENERATIONS_PER_DAY=20
EXPORTS_PER_DAY=30
MAX_PROJECTS_PER_USER=50

WORKER_CONCURRENCY=1
# Nightly database backup to R2 at 03:00 UTC, kept 14 days.
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=14
