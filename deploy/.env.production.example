# Copy to .env.production at the repo root ON THE SERVER (never commit it).
# Values marked <from terraform> come from `terraform output`.

DOMAIN=studio.example.com
ACME_EMAIL=you@example.com

# `openssl rand -base64 32`
POSTGRES_PASSWORD=
# `openssl rand -base64 48`
SESSION_SECRET=

NODE_ENV=production
LOG_LEVEL=info
# Clerk production instance keys (Clerk dashboard → API Keys). Restrict sign-ups there.
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Cloudflare R2
STORAGE_DRIVER=s3
S3_ENDPOINT=<from terraform: r2_s3_endpoint>
S3_REGION=auto
S3_BUCKET=<from terraform: r2_bucket>
# Create an R2 API token (Object Read & Write, this bucket only) in the
# Cloudflare dashboard: R2 → Manage API tokens.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- AI providers (keys stay on the server; the browser never sees them) ----------
# Leave a key empty to switch that feature off. Each call spends credits on your account.
FAL_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
# For local tests without keys, run `node scripts/mock-providers.mjs` and point these at it:
# FAL_QUEUE_URL=http://localhost:4010/queue
# FAL_RUN_URL=http://localhost:4010/run
# ELEVENLABS_URL=http://localhost:4010
# ANTHROPIC_URL=http://localhost:4010

# Guardrails
MAX_UPLOAD_MB=500
STORAGE_QUOTA_MB=5000
EXPORTS_PER_DAY=30
# Per person, per 24 hours:
VIDEO_JOBS_PER_DAY=40
IMAGE_JOBS_PER_DAY=150
TTS_CHARS_PER_DAY=30000
LLM_CALLS_PER_DAY=100

WORKER_CONCURRENCY=1
# Nightly database backup to R2 at 03:00 UTC, kept 14 days.
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=14
