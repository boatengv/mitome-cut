{
  "name": "@mitome/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=../../.env src/api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate-cli.ts",
    "build": "node build.mjs",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.920.0",
    "@aws-sdk/s3-request-presigner": "^3.920.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@mitome/shared": "*",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "pg-boss": "^12.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6"
  }
}
